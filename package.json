{
  "name": "news-reader",
  "version": "0.0.1",
  "private": true,
  "author": "David Duran <contacto@altmails.com> (https://totallynotdavid.github.io/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/caefisica/rss-reader.git"
  },
  "workspaces": [
    "packages/*",
    "workers/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "ingest": "bun run scripts/ingest.ts",
    "migrate:local": "wrangler d1 execute news-reader --local --file migrations/0001_init.sql && wrangler d1 execute news-reader --local --file migrations/0002_seed_sources.sql",
    "migrate:remote": "wrangler d1 execute news-reader --file migrations/0001_init.sql && wrangler d1 execute news-reader --file migrations/0002_seed_sources.sql"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@news-reader/feeds": "workspace:*",
    "gsap": "^3.12.5",
    "nuxt": "^4.0.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.92.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
