{
  "name": "news-reader",
  "version": "0.0.1",
  "private": true,
  "author": "David Duran <contacto@altmails.com> (https://totallynotdavid.github.io/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/caefisica/rss-reader.git"
  },
  "workspaces": [
    "packages/*",
    "workers/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "ingest": "bun run scripts/ingest.ts",
    "db:migrate": "wrangler d1 migrations apply news-reader --remote",
    "db:migrate:local": "wrangler d1 migrations apply news-reader --local",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@news-reader/feeds": "workspace:*",
    "@nuxt/icon": "^2.2.2",
    "gsap": "^3.12.5",
    "nuxt": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.65.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.92.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
